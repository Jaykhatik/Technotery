<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= home.homeName %> - Stay Retro</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/theme/theme.css">
    <script src="/theme/theme-toggle.js"></script>
  </head>
  <body>
    <div class="retro-paper-container">
      <%- include('partials/nav') %>

      <div class="detail-wrapper">

        <!-- ── Breadcrumb ── -->
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/" class="bc-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            All Homes
          </a>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-item bc-current" aria-current="page"><%= home.location %></span>
          <span class="bc-sep" aria-hidden="true">›</span>
          <span class="bc-item bc-current"><%= home.homeName %></span>
        </nav>

        <!-- ── Hero image ── -->
        <div class="detail-hero">
          <img
            src="<%= home.photoUrl %>"
            alt="<%= home.homeName %>"
            class="detail-hero-img"
          />
          <!-- Rating badge over image -->
          <div class="detail-rating-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <%= home.rating %>
          </div>
        </div>

        <!-- ── Two-column content ── -->
        <div class="detail-body">

          <!-- LEFT: main info -->
          <div class="detail-main">
            <p class="detail-location-tag">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <%= home.location %>
            </p>
            <h1 class="detail-title"><%= home.homeName %></h1>

            <div class="detail-divider"></div>

            <!-- Stats row -->
            <div class="detail-stats">
              <div class="detail-stat">
                <span class="detail-stat-label">Rating</span>
                <span class="detail-stat-value">★ <%= home.rating %></span>
              </div>
              <div class="detail-stat-sep"></div>
              <div class="detail-stat">
                <span class="detail-stat-label">Location</span>
                <span class="detail-stat-value"><%= home.location %></span>
              </div>
              <div class="detail-stat-sep"></div>
              <div class="detail-stat">
                <span class="detail-stat-label">Type</span>
                <span class="detail-stat-value"><%= home.type || 'Entire Home' %></span>
              </div>
            </div>

            <div class="detail-divider"></div>

            <!-- Description block -->
            <div class="detail-desc-block">
              <h2 class="detail-section-title">About This Place</h2>
              <p class="detail-desc-text">
                <% if (home.description) { %>
                  <%= home.description %>
                <% } else { %>
                  Welcome to <strong><%= home.homeName %></strong> — a hand-picked retro getaway nestled in
                  <strong><%= home.location %></strong>. This property blends vintage charm with all the comforts
                  you need for a perfect stay. Ideal for couples, small groups, or solo travellers
                  looking for a unique experience with character and style.
                <% } %>
              </p>
            </div>

            <div class="detail-divider"></div>

            <!-- Highlights -->
            <div class="detail-highlights">
              <h2 class="detail-section-title">Highlights</h2>
              <ul class="detail-highlights-list">
                <% if (home.highlights && home.highlights.length > 0) { %>
                  <% home.highlights.forEach(function(highlight) { %>
                    <li>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <%= highlight %>
                    </li>
                  <% }) %>
                <% } else { %>
                  <li>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    Entire property — no shared spaces
                  </li>
                  <li>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    Retro aesthetic with modern amenities
                  </li>
                <% } %>
              </ul>
            </div>
          </div><!-- /.detail-main -->

          <aside class="detail-booking-card">
            <div class="booking-price-row">
              <span class="booking-price"><span>$<%= home.price %></span></span>
              <span class="booking-per-night">/ night</span>
            </div>

            <div class="booking-divider"></div>

            <div class="booking-meta">
              <div class="booking-meta-row">
                <span>Rating</span>
                <strong>★ <%= home.rating %></strong>
              </div>
              <div class="booking-meta-row">
                <span>Location</span>
                <strong><%= home.location %></strong>
              </div>
            </div>

            <div class="booking-divider"></div>

            <a href="/" class="btn-primary booking-cta" style="display:block; text-decoration:none; text-align:center;">
              Reserve Now
            </a>

            <p class="booking-note">You won't be charged yet</p>

            <div class="booking-total-row">
              <span>$<%= home.price %> × 1 night</span>
              <span>$<%= home.price %></span>
            </div>
            <div class="booking-total-row booking-total-final">
              <span>Total</span>
              <strong>$<%= home.price %></strong>
            </div>
          </aside>

        </div><!-- /.detail-body -->

      </div><!-- /.detail-wrapper -->

      <%- include('partials/footer') %>
    </div>
  </body>
</html>
